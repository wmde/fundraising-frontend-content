#!/usr/bin/env php
<?php

use JetBrains\PhpStorm\NoReturn;

/**
 * This script exports a use_of_funds_content[_YEAR].json and thank_you_content[_YEAR].json files to HTML tags with data attributes
 * The HTML tag can then be put on a page on meta.wikipedia.org and transcluded in CentralNotice banners
 * 
 * @param string $fileName
 * @param string $output
 * @param string $language
 * @param string $year
 *
 * @return void
 */
#[NoReturn]
function extractContent( string $fileName, string $output, string $language, string $year ): void {
	$fileNameSuffix = $year !== '' ? "_{$year}" : '';
	$finalFileName = "{$fileName}{$fileNameSuffix}.json";

	$filePath = __DIR__ ."/../i18n/{$language}/data/{$finalFileName}";

	if ( !file_exists( $filePath ) ) {
		die( "File not found: {$filePath}\n" );
	}

	$contents = file_get_contents( $filePath );
	$json = json_decode( $contents );
	$encodedContent = htmlspecialchars(
		json_encode( $json ),
		ENT_QUOTES,
		'UTF-8'
	);

	$textForMediaWiki = <<<TPL
	<noinclude>
	This page contains content used in Wikimedia Deutschland banners 
	</noinclude>
	<div data-{$output}="$encodedContent" id="wmde-{$output}"/>
	TPL;

	$outputFileName = "{$output}-{$language}{$fileNameSuffix}.txt";
	if ( file_put_contents( $outputFileName, $textForMediaWiki ) === false ) {
		die( "Error writing output file: {$outputFileName}\n" );
	}

	exit( "Wrote {$outputFileName}\n" );
}

$fileNameArg = $argv[1] ?? '';
$outputArg = $argv[2] ?? '';
$langArg = $argv[3] ?? '';
$yearArg = $argv[4] ?? '';

switch( $langArg ) {
	case 'de':
		$language = 'de_DE';
		break;
	case 'en':
		$language = 'en_GB';
		break;
	default:
		die( "You must provide a language (de | en )!\n" );
}

if ( $yearArg !== '' && !preg_match( '/^[1-9]\d{3}$/', $yearArg ) ) {
	die( "If provided, the year must be in YYYY format (e.g. 2023).\n" );
}

extractContent( $fileNameArg, $outputArg, $language, $yearArg );

?>
