#!/usr/bin/env php
<?php

/**
 * This script exports a use_of_funds_content[_YEAR].json file to an HTML tag with a data attribute
 * The HTML tag can then be put on a page on meta.wikipedia.org and transcluded in CentralNotice banners
 *
 * @file
 */

$langArg = $argv[1] ?? '';
$yearArg = $argv[2] ?? '';

switch( $langArg ) {
	case 'de':
		$language = 'de_DE';
		break;
	case 'en':
		$language = 'en_GB';
		break;
	default:
		die( "You must provide a language (de | en )!\n" );
}

if ( $yearArg !== '' && !preg_match( '/^[1-9]\d{3}$/', $yearArg ) ) {
	die( "If provided, the year must be in YYYY format (e.g. 2023).\n" );
}

$initFileName = 'use_of_funds_content';
$fileNameSuffix = $yearArg !== '' ? "_{$yearArg}" : '';
$finalFileName = "{$initFileName}{$fileNameSuffix}.json";

$filePath = __DIR__ ."/../i18n/{$language}/data/{$finalFileName}";

if ( !file_exists( $filePath ) ) {
	die( "File not found: {$filePath}\n" );
}

$contents = file_get_contents( $filePath );
$json = json_decode( $contents );
$encodedContent = htmlspecialchars(
	json_encode( $json ),
	ENT_QUOTES,
	'UTF-8'
);

$textForMediaWiki = <<<TPL
<noinclude>
This page contains the 2023 WMDE Fundraising Campaign metadata for the "Use of Funds" modal as a HTML5 data attribute. 
</noinclude>
<div data-use-of-funds="$encodedContent" id="wmde-use-of-funds"/>
TPL;

$outputFileName = "mediawiki_use_of_funds_{$langArg}{$fileNameSuffix}.txt";
if ( file_put_contents( $outputFileName, $textForMediaWiki ) === false ) {
	die( "Error writing output file: {$outputFileName}\n" );
}

exit( "Wrote {$outputFileName}\n" );

?>
